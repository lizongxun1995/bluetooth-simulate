<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>BtWinRT</RootNamespace>
    <AssemblyName>btwinrt</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="32feet.NET" Version="3.5.0" />
    <!-- 32feet(net461时代包)的隐藏依赖: 旧工程靠 WinForms(WindowsDesktop 运行时)捎带, 去掉
         WinForms/pythonnet 宿主后必须显式引用, 否则扫描报缺程序集或"No supported stack" -->
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
